{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Region",
  "type": "object",
  "required": ["soato", "name", "population_2026_official"],
  "properties": {
    "soato": {"type": "string", "pattern": "^[0-9]{4}$"},
    "name": {"type": "string", "minLength": 1},
    "population_2026_official": {"type": "integer", "minimum": 0},
    "area_km2": {"type": "number", "minimum": 0},
    "mahallas_with_polygon_in_source": {"type": "integer", "minimum": 0}
  }
}
